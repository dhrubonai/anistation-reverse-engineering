<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#ff2b2d37" />
            <stroke android:width="1.0dip" android:color="#ff454a56" />
            <corners android:radius="14.0dip" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="#ff2b2d37" />
            <stroke android:width="1.0dip" android:color="#ff454a56" />
            <corners android:radius="14.0dip" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#ff121214" />
            <stroke android:width="1.0dip" android:color="#ff24262d" />
            <corners android:radius="14.0dip" />
        </shape>
    </item>
</selector>